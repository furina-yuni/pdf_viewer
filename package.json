{
  "name": "study-pdf-ai",
  "private": true,
  "version": "0.1.2",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "conda run -n pdf-viewer uvicorn app.main:app --app-dir backend --reload --port 8000",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"npm:dev:backend\" \"vite --port 5173\" \"wait-on tcp:8000 http://localhost:5173 && electron electron/main.cjs\"",
    "build:backend": "conda run -n pdf-viewer pyinstaller --noconfirm --clean --distpath backend/dist --workpath backend/build backend/study-pdf-backend.spec",
    "electron:build": "npm run build && npm run build:backend && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-pdf": "^9.2.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.study.pdfai",
    "productName": "Study PDF AI",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "web"
      },
      {
        "from": "backend/dist/study-pdf-backend.exe",
        "to": "backend/study-pdf-backend.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Study-PDF-AI-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Study PDF AI"
    }
  }
}
